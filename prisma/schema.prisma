generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

/// Single-row table (id is always "default") holding store-wide info: name,
/// description, payment instructions and how long a cart reservation holds
/// stock before it's released back.
model StoreSettings {
  id                 String   @id
  storeName          String
  description        String
  logoUrl            String?
  bizumPhone         String?
  bankAccount        String?
  bankHolder         String?
  paymentNotes       String?
  reservationMinutes Int      @default(60)
  updatedAt          DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  status      ProductStatus @default(DRAFT)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Every product has one or more variants (e.g. sizes, colors) even if it's
/// really just a single option — that keeps price/stock uniformly on the
/// variant instead of duplicated on both Product and ProductVariant.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String // e.g. "M", "Talla única", "Rojo - L"
  price Int // cents
  stock Int  @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Order {
  id String @id @default(cuid())

  buyerName    String
  buyerEmail   String
  buyerPhone   String
  buyerAddress String

  items       OrderItem[]
  totalAmount Int
  status      OrderStatus @default(PENDING)

  paymentReference String?
  adminNotes       String?

  reservedUntil DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([buyerEmail])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  // Snapshots so order history stays accurate even if the product/variant is
  // later edited, renamed or deleted.
  productName  String
  variantLabel String
  unitPrice    Int
  quantity     Int

  @@index([orderId])
  @@index([productVariantId])
}
