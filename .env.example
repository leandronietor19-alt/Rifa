# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, local, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/rifa"

# Random long secret used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Credentials used by `npm run seed` to create the first admin user.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Administrador"

# Shown in the site header/title.
NEXT_PUBLIC_SITE_NAME="Baboon"

# --- Email notifications (optional) ---
# Without RESEND_API_KEY, the app works fine and just skips sending emails.
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address. Must be on a domain you've verified in Resend, or leave as
# the shared testing address (which can only email your own Resend account).
EMAIL_FROM="onboarding@resend.dev"
# Where "new order" alerts are sent. Defaults to ADMIN_EMAIL if unset.
NOTIFICATION_EMAIL=""
# Public URL of the deployed site, used for links inside emails. On Vercel
# this is usually not needed (falls back to VERCEL_URL automatically).
NEXT_PUBLIC_SITE_URL=""
